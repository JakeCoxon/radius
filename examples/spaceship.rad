import compiler
import range for Range
import random for simple_random_float
import vec for vec2, vec3, vec4
import color for hsva_to_rgba, rgb
import matrix for mat4, mat4_identity, create_perspective_projection, mul_mat4_vec4, mul_mat4_mat4, ndc_to_screen
import array for Array, array_create
import graphics for frame_ticks, get_mouse_down, put_float_image_data, get_mouse_x, get_mouse_y, set_fill_color, move_to, line_to, stroke, set_stroke_color_rgba, begin_path, set_line_width, fill_rectangle, draw_defaults, begin_triangles, vertex, end_draw, translate3d, push_matrix, pop_matrix, rotate3d, get_key_down, scale3d

const window_width = 320
const window_height = 240

var num_ticks = 0

fn init() @export {
  0
}

define Player {
  var pos: vec2
  var velocity: vec2
  var dodge_velocity: float
}

define Bullet {
  var pos: vec2
  var velocity: vec2
}
var last_bullet = 0
var last_dodge = 0

var player = Player(
  pos: vec2(0, 0),
  velocity: vec2(0, 0),
  dodge_velocity: 0
)
var bullets = array_create!Bullet(0)

fn frame() @export {
  if get_key_down(256) { exit(0) }

  draw_defaults()
  num_ticks += 1

  update_player()

  
  block {
    push_matrix()
    translate3d(sin(num_ticks.float * 0.01) * 0.1, 0, 0)
    scale3d(5, 5, 5)
    
    begin_triangles()
    vertex(vec2( 0.0,  0.5), rgb(1, 1, 0))
    vertex(vec2(-0.5, -0.5), rgb(0, 1, 1))
    vertex(vec2( 0.5, -0.5), rgb(1, 0, 1))
    end_draw()
    pop_matrix()
  }

  block {
    push_matrix()
    rotate3d(num_ticks.float * 0.01, 0, 0, 1)
    
    begin_triangles()
    vertex(vec2( 0.0,  0.5), rgb(1, 1, 0))
    vertex(vec2(-0.5, -0.5), rgb(0, 1, 1))
    vertex(vec2( 0.5, -0.5), rgb(1, 0, 1))
    end_draw()
    pop_matrix()
  }

  block {
    push_matrix()
    translate3d(player.pos.x, player.pos.y, 0)
    scale3d(0.1, 0.1, 0.1)
    rotate3d(-0.5 * PI, 0, 0, 1)
    
    begin_triangles()
    vertex(vec2( 0.0,  0.5), rgb(1, 0, 0))
    vertex(vec2(-0.5, -0.5), rgb(0, 0, 1))
    vertex(vec2( 0.5, -0.5), rgb(0, 1, 0))
    end_draw()
    pop_matrix()
  }

  for b in bullets {
    push_matrix()
    translate3d(b.pos.x, b.pos.y, 0)
    scale3d(0.04, 0.04, 0.04)
    rotate3d(-0.5 * PI, 0, 0, 1)
    
    begin_triangles()
    vertex(vec2( 0.0,  0.5), rgb(1, 0, 0))
    vertex(vec2(-0.5, -0.5), rgb(0, 0, 1))
    vertex(vec2( 0.5, -0.5), rgb(0, 1, 0))
    end_draw()
    pop_matrix()
  }
}

fn update_player() {
  let key_down = get_key_down(264) // Down
  let key_up = get_key_down(265) // Up
  let key_left = get_key_down(263) // Left
  let key_right = get_key_down(262) // Right
  let key_a = get_key_down(65) // A
  let key_z = get_key_down(90) // Z
  
  let max_velocity = 0.01
  let move_acceleration = 0.001
  let dodge_deceleration = 0.8
  let dodge_initial_velocity = 0.1
  let deceleration = 0.98

  let left_right_delta = key_right.int - key_left.int
  let up_down_delta = key_up.int - key_down.int
  
  if up_down_delta != 0 {
    player.velocity.y += up_down_delta.float * move_acceleration
  } else {
    player.velocity.y *= deceleration
  }

  if left_right_delta != 0 {
    player.velocity.x += left_right_delta.float * move_acceleration
  } else {
    player.velocity.x *= deceleration
  }

  player.velocity.x&.clamp(-max_velocity, max_velocity)
  player.velocity.y&.clamp(-max_velocity, max_velocity)
  
  var current_velocity = player.velocity.copy
  if current_velocity.length > max_velocity {
    current_velocity&.normalize()
    current_velocity *= max_velocity
  }

  if key_z and up_down_delta != 0 {
    if num_ticks - last_dodge > 60 {
      last_dodge = num_ticks
      player.dodge_velocity = dodge_initial_velocity * up_down_delta.float
    }
  }
  current_velocity.y += player.dodge_velocity

  if player.dodge_velocity.abs > 0.000001 {
    player.dodge_velocity *= dodge_deceleration
  }

  
  player.pos += current_velocity

  if player.pos.y < -1 {
    player.pos.y = -1
    player.velocity.y = 0
  } else if player.pos.y > 1 {
    player.pos.y = 1
    player.velocity.y = 0
  }

  if player.pos.x < -1 {
    player.pos.x = -1
    player.velocity.x = 0
  } else if player.pos.x > 1 {
    player.pos.x = 1
    player.velocity.x = 0
  }

  // Bullets

  var any_to_remove = false

  fn in_bounds(pos: vec2) -> bool {
    pos.y >= -1 and pos.y <= 1 and pos.x >= -1 and pos.x <= 1
  }

  for b in bullets {
    b.pos += b.velocity
    if !in_bounds(b.pos) {
      any_to_remove = true
    }
  }

  // Do it by creating a new array. This should be improved
  if any_to_remove {
    var new_bullets = array_create!Bullet(0)
    for b in bullets {
      if in_bounds(b.pos) {
        new_bullets&.append(b.copy)
      }
    }
    bullets = new_bullets&
  }

  let bullet_repeat_ticks = 20

  if key_a {
    if num_ticks - last_bullet > bullet_repeat_ticks {
      last_bullet = num_ticks
      bullets&.append(Bullet(
        pos: player.pos,
        velocity: vec2(0.05, 0)
      ))
    }
  }
}

fn cleanup() @export {
  0
}

fn on_event() @export {
  0
}