import compiler
import range for Range
import random for simple_random_float
import vec for vec2i
import color for hsva_to_rgba, rgba
import array for Array, array_create
import graphics for frame_ticks, get_mouse_down, put_float_image_data, get_mouse_x, get_mouse_y, draw_canvas_to_screen

const window_width = 320
const window_height = 240

const cells_width = window_width
const cells_height = window_height

var cells = array_create!int(cells_width * cells_height)
var next_cells = array_create!int(cells_width * cells_height)
var rgba_image = array_create!rgba(cells_width * cells_height)
var prev_mouse = vec2i(0, 0)

var current_color = 200.0

fn init() @export {

  cells[:] = 0 ...
  next_cells[:] = 0 ...
}

fn frame() @export {

  next_cells[:] = 0 ...
  let pressed_left = get_mouse_down(0)
  let pressed_right = get_mouse_down(1)
  let mouse = vec2i(get_mouse_x(), get_mouse_y())
  let mouse_velocity = mouse - prev_mouse
  prev_mouse = mouse.copy

  let mouse_size = 4 + mouse_velocity.x.abs / 4

  if pressed_left {
    current_color += 0.1
    if current_color > 360.0 {
      current_color = 1.0
    }
  }

  for y in Range(0, cells_height - 1) {
    for x in Range(1, cells_width - 1) {

      let cell = x + y * cells_width
      let down = cell + cells_width
      let down_left = down - 1
      let down_right = down + 1

      let cell_value = cells[x + y * cells_width]

      let bottom_edge = y == cells_height - 2

      let down_blocked = cells[down] > 0 or bottom_edge.copy
      let down_left_blocked = cells[down_left] > 0 or bottom_edge.copy or x == 1
      let down_right_blocked = cells[down_right] > 0 or bottom_edge.copy or x == cells_width - 2

      if cell_value > 0 {
        if !down_blocked {
          next_cells[down] = cell_value
        } else if !down_left_blocked {
          next_cells[down_left] = cell_value
        } else if !down_right_blocked {
          next_cells[down_right] = cell_value
        } else {
          next_cells[cell] = cell_value
        }
      }

      let in_circle = (mouse - vec2i(x, y)).length_squared < mouse_size * mouse_size
      if in_circle {
        if pressed_left {
          next_cells[cell] = int(current_color + simple_random_float() * 10)
        } else if pressed_right {
          next_cells[cell] = 0
        }
      }
    }
  }

  for y in Range(0, cells_height) {
    for x in Range(0, cells_width) {

      let cell = next_cells[x + y * cells_width]
      var color = rgba(0, 0, 0, 0)
      if cell > 0 {
        color = hsva_to_rgba(float(cell), 0.7, 0.7, 1)
      }

      rgba_image[x + y * cells_width] = color.copy
    }
  }
    
  put_float_image_data(rgba_image.data.data, cells_width, cells_height, window_width * 4, 0, 0)
  draw_canvas_to_screen()

  swap(cells, next_cells)
}

fn cleanup() @export {
  0
}

fn on_event() @export {
  0
}