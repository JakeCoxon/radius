import compiler
import range for Range
import random for simple_random_float
import vec for vec3, vec4
import color for hsva_to_rgba
import matrix for mat4, mat4_identity, create_perspective_projection, mul_mat4_vec4, mul_mat4_mat4, ndc_to_screen
import array for Array, array_create
import graphics for frame_ticks, get_mouse_down, put_float_image_data, get_mouse_x, get_mouse_y, set_fill_color, fill_rectangle, move_to, line_to, stroke, set_stroke_color, begin_path, draw_canvas_to_screen

const window_width = 320
const window_height = 240

const band = compiler.operator_bitwise_and

var t = 0.0
let cube_edges = [(0, 1), (0, 2), (3, 1), (3, 2), (4, 5), (4, 6), (7, 5), (7, 6), (0, 4), (1, 5), (2, 6), (3, 7)]
var attractor_points = array_create!vec3(0)

let cube_points = block {
  var ar = array_create!vec3(8)
  for n in Range(0, 8) {
    ar[n] = vec3(
      float(band(n / 4, 1)) - 0.5, 
      float(band(n / 2, 1)) - 0.5, 
      float(band(n / 1, 1)) - 0.5)
  }
  ar
}

let screen_coords = array_create!vec3(0)
let projection = create_perspective_projection(
    120, window_width / window_height, 0.1, 10000)

fn attractor(pos: vec3) -> vec3 {
  let sigma = 10.0
  let row = 28.0
  let beta = 2.6
  let speed = 0.01

  let dx = sigma * (-pos.x + pos.y)
  let dy = -pos.x * pos.z + row * pos.x - pos.y
  let dz = pos.x * pos.y - beta * pos.z

  pos + vec3(dx * speed, dy * speed, dz * speed)
}
  
fn init() @export {
  0
}

fn frame() @export {
  set_fill_color(0, 0, 0, 1)
  fill_rectangle(0, 0, window_width, window_height)

  if attractor_points.length == 0 {
    attractor_points&.append(vec3(1.1, 2, 7))
  }

  t += 0.1
  
  if attractor_points.length < 2000 {
    let prev_point = attractor_points[attractor_points.length - 1]
    let new_point = attractor(prev_point)
    attractor_points&.append(new_point.copy)
  } else {
    attractor_points.length = 1
  }

  let transform = (
    mat4_identity()
    .scale(2.5, 2.5, 2.5)
    .rotate_y(t * 0.1)
    .rotate_x(0.2)
    .translate(0, 0, -10)
    .premul(projection)
  )

  set_fill_color(1, 1, 1, 1)

  screen_coords.length = 0
  
  let attractor_point_start = screen_coords.length.copy // TODO: Fix this copy

  for point in attractor_points {
    let scale = 0.02
    let vec = vec4(point.x * scale , point.y * scale, point.z * scale - 0.5, 1)

    let clip_coords = mul_mat4_vec4(transform, vec)
    let ndc = clip_coords.xyz / clip_coords.w

    if clip_coords.w < 0 {
      screen_coords&.append(vec3(0, 0, 10))
      continue
    }

    let screen = ndc_to_screen(ndc, window_width, window_height)
    screen_coords&.append(screen.copy)
  }

  set_stroke_color(1, 1, 1, 1)
  begin_path()
  for i in Range(0, attractor_points.length) {
    if i == 0 {
      move_to(screen_coords[i].xy)
    } else {
      line_to(screen_coords[i].xy)
    }
  }
  stroke()


  // Cube border

  screen_coords.length = 0

  for point in cube_points {
    let vec = vec4(point.x, point.y, point.z, 1)

    let clip_coords = mul_mat4_vec4(transform, vec)
    let ndc = clip_coords.xyz / clip_coords.w

    if clip_coords.w < 0 {
      screen_coords&.append(vec3(0, 0, 0))
      continue
    }

    let screen = ndc_to_screen(ndc, window_width, window_height)
    screen_coords&.append(screen.copy)
  }

  set_stroke_color(1, 0, 0, 1)
  for a, b in cube_edges {

    begin_path()
    move_to(screen_coords[a].xy)
    line_to(screen_coords[b].xy)
    stroke()
  }

  draw_canvas_to_screen()
}

fn cleanup() @export {
  0
}

fn on_event() @export {
  0
}