import compiler

fn malloc_or_exit(size_bytes: int) -> rawptr {
  var ptr = malloc(size_bytes: size_bytes)
  if ptr == rawptr(0) {
    print("Failed to allocate memory")
    exit(status: 1)
  }
  ptr
}



define Buffer @struct {
  size: int // size in bytes
  data: rawptr

  const __destructor = deinit_buffer
  const __move_init = move_init_buffer
  const __move_assign = move_assign_buffer
  const __copy = copy_buffer
}


fn buffer_alloc(_ buf: inout Buffer, size_bytes: int) {
  buf&.deinit_buffer()
  buf.size = size_bytes
  buf.data = malloc_or_exit(size_bytes: size_bytes)
  memset(pointer: buf.data&, value: u8(0), size_bytes: size_bytes)
}


fn copy_buffer(_ dst: set Buffer, _ buf: Buffer) {
  dst.size = buf.size
  dst.data = malloc_or_exit(size_bytes: buf.size)
}


fn move_init_buffer(_ dst: set Buffer, _ src: sink Buffer) {
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)
}


fn move_assign_buffer(_ dst: inout Buffer, _ src: sink Buffer) {
  deinit_buffer(dst&)
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)
  src.size = 0
}


fn deinit_buffer(_ buf: sink Buffer) {
  if buf.data != rawptr(0) {
    free(pointer: buf.data)
    buf.data = rawptr(0)
  }
}

define Array!(T) @struct {
  length: int
  data: Buffer

  const __iterate = array_iterate
  const __subscript = get_array
  const __subscript_inout = subscript_inout
  const __subscript_sink = subscript_sink
  const __copy = copy_array
  const __move_init = move_init_array
  const __move_assign = move_assign_array
  const __destructor = deinit_array
  const __length = array_length
  const __print = array_print
}


fn array_print!(T)(_ arr: Array!T) {
  var i = 0
  print("[", endl: false)
  while i < arr.length {
    if i > 0 {
      print(", ", endl: false)
    }
    print(arr[i], endl: false)
    i += 1
  }
  print("]", endl: false)
}


fn array_length!(T)(arr: Array!T) -> int {
  arr.length
}


// This will zero initialize the array. TOOD: Make this better
fn array_create!(T)(initial_length: int) -> Array!T {
  var buffer = Buffer(size: 0, data: rawptr(0))
  var array = Array!T(length: 0, data: buffer&)
  array&.reserve_array(capacity: initial_length)
  array.length = initial_length

  memset(pointer: array.data.data&, value: u8(0), size_bytes: initial_length)
  array
}


fn append!(T)(_ array: inout Array!T, _ element: sink T) @method {
  let current_size_bytes = array.length * (meta T.sizeof)
  if current_size_bytes == array.data.size {
    var new_capacity = array.data.size
    new_capacity = 16 if new_capacity == 0
    new_capacity *= 2
    array&.reserve_array(capacity: new_capacity)
  }

  compiler.unsafe_set_subscript(array.data.data, array.length, element&)
  array.length += 1
}


fn reserve_array!(T)(_ arr: inout Array!T, capacity: int) {
  if capacity > arr.data.size {
    let size_bytes = capacity * (meta T.sizeof)
    arr.data&.buffer_alloc(size_bytes: size_bytes)
  }
}


fn get_array!(T)(_ arr: Array!T, _ index: int, _ f) @subscript {
  if arr.data.data == rawptr(0) {
    print("Not allocated")
    exit(status: 0)
  }
  if index < 0 or index >= arr.length {
    print("Bounds check failed")
    exit(status: 0)
  }
  f(compiler.unsafe_subscript!T(arr.data.data, index))
}


fn copy_array!(T)(_ dst: set Array!T, _ src: Array!T) {
  dst.length = src.length
  dst.data = Buffer(size: 0, data: rawptr(0))
  dst.data&.buffer_alloc(size_bytes: src.length * (meta T.sizeof))

  var i = 0
  while i < src.length {
    dst[i] = src[i].copy
    i += 1
  }

  // TODO: Too many moves ends up calling destructorFoo a lot
  // TODO: The copy is moving the value out of src[i] (need projection)
  // TODO: Do a mem-copy if possible
}

fn memset(pointer ptr: inout rawptr, value: u8, size_bytes size: int) {
  var i = 0
  while i < size {
    compiler.unsafe_set_subscript(ptr, i, value)
    i += 1
  }
}


fn subscript_inout!(T)(_ arr: inout Array!T, _ idx: int, _ f) @subscript {
  var ref input = compiler.unsafe_subscript!T(arr.data.data, idx)&
  f(input)
}


fn subscript_sink!(T)(_ arr: sink Array!T, _ idx: int, _ f) @subscript {
  var input = compiler.unsafe_subscript!T(arr.data.data, idx)&
  f(input)
}

fn subscript_let!(T)(_ arr: Array!T, _ idx: int, _ f) @subscript {
  let input = compiler.unsafe_subscript!T(arr.data.data, idx)
  f(input)
}


fn array_iterate!(f, T)(_ array: Array!T) -> void @inline {
  var i = 0
  while i < array.length {
    f(array[i])
    i += 1
  }
}


fn array_iterate_inout!(T)(_ array: inout Array!T, _ f) -> void @inline {
  var i = 0
  while i < array.length {
    f(array[i]&)
    i += 1
  }
}


fn move_init_array!(T)(_ dst: set Array!T, _ src: sink Array!T) {
  dst.length = src.length&
  dst.data = src.data&
  src.data = Buffer(size: 0, data: rawptr(0))
}


fn move_assign_array!(T)(_ dst: inout Array!T, _ src: sink Array!T) {
  deinit_array(dst&)
  dst.length = src.length&
  dst.data = src.data&
  src.data = Buffer(size: 0, data: rawptr(0))
}


fn deinit_array!(T)(_ arr: sink Array!T) {
  if arr.data.data != rawptr(0) {
    var i = 0
    while i < arr.length {
      var input = compiler.unsafe_subscript!T(arr.data.data, i)&
      i += 1
    }
    arr.data&.deinit_buffer()
  }
}
