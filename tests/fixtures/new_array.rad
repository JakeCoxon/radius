import compiler

fn malloc_or_exit(size: int) -> rawptr:
  var ptr = malloc(size)
  if ptr == rawptr(0):
    exit(1)
  print("Malloc", size, ptr)
  ptr

type Foo @struct:
  x: int
  y: float


type Buffer @struct:
  size: int
  data: rawptr

  const __destructor = deinit_buffer
  const __move_init = move_init_buffer
  const __move_assign = move_assign_buffer
  const __copy = copy_buffer


fn buffer_alloc(buf: inout Buffer, size: int):
  print("Alloc size", size)
  buf.size = size
  buf.data = malloc_or_exit(size)
  var i = 0
  while i < size:
    compiler.unsafe_set_subscript(buf.data, i, u8(0))
    i += 1


fn copy_buffer(dst: set Buffer, buf: Buffer):
  print("Copy buffer")
  dst.size = buf.size
  dst.data = malloc_or_exit(buf.size)


fn move_init_buffer(dst: set Buffer, src: sink Buffer):
  print("Move init buffer", dst as rawptr, src as rawptr)
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)


fn move_assign_buffer(dst: inout Buffer, src: sink Buffer):
  print("Move assign buffer", dst as rawptr, src as rawptr)
  deinit_buffer(dst&)
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)
  src.size = 0


fn deinit_buffer(buf: sink Buffer):
  print("Deinit buffer", buf as rawptr)
  if buf.data != rawptr(0):

    print("Free buffer", buf.data as rawptr)
    free(buf.data)
    buf.data = rawptr(0)


type Array!(T) @struct:
  len: int
  data: Buffer

  const __set_subscript = set_array
  const __subscript = get_array
  const __subscript_inout = subscript_inout
  const __copy = copy_array
  const __move_init = move_init_array
  const __move_assign = move_assign_array
  const __destructor = deinit_array


fn init_array!(T)(arr: inout Array!T, len: int):
  arr.len = len
  print("meta T.sizeof", (meta T.sizeof))
  let size_bytes = len * (meta T.sizeof)
  arr.data&.buffer_alloc(size_bytes)


fn reserve_array!(T)(arr: inout Array!T, len: int):
  print("Reserve array", len, arr.len)
  # if len > arr.len:
  #   arr.len = len
  #   let size_bytes = len * (meta T.sizeof)
  #   arr.data&.buffer_alloc(size_bytes)


fn set_array!(T)(arr: inout Array!T, index: int, value: sink T) @inline:
  arr&.reserve_array(index + 1)
  # if arr.data.data == rawptr(0):
  #   print("Not allocated")
  #   exit(0)
  # if index < 0 or index >= arr.len:
  #   print("Bounds check failed")
  #   exit(0)
    # arr&.init_array(10)
  compiler.unsafe_set_subscript(arr.data.data, index, value&)


fn get_array!(T)(arr: Array!T, index: int, f) @subscript:
  # if true:
  #   print("Not allocated")
  #   exit(1)
  if arr.data.data == rawptr(0):
    print("Not allocated")
    exit(0)
  if index < 0 or index >= arr.len:
    print("Bounds check failed")
    exit(0)
  f(compiler.unsafe_subscript!T(arr.data.data, index))
  # f(3)


fn copy_array!(T)(dst: set Array!T, src: Array!T):
  print("T.sizeof", (meta T.sizeof))
  print("src.len", src.len)
  print("alloc_size", src.len * (meta T.sizeof))
  
  dst.len = src.len
  dst.data = Buffer(0, rawptr(0))
