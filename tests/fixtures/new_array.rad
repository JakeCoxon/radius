fn bar(x: inout int):
  x += 1


fn baz(foo: inout Foo):
  foo.x += 1


fn test_array1():

  var buffer = Buffer(0, rawptr(0))
  var arr = Array!int(0, buffer&)
  arr&.init_array(5)

  arr[0] = 10
  arr[1] = 20
  arr[2] = 20
  arr[3] = 20
  arr[4] = 20
  print(arr[0])

  var arr2 = arr.copy
  print(arr2[0])

fn test_array2():

  var buffer = Buffer(0, rawptr(0))
  var arr = Array!Foo(0, buffer&)
  arr&.init_array(10)

  arr[0] = Foo(3, 2.0)
  arr[1] = Foo(4, 3.0)

  arr[0].x += 1
  print(arr[0].x)

  var arr2 = arr&
  let el = arr2[0]

  print(el.x)
  arr2[0].x += 1
  print(arr2[0].x)
  # # print(arr[0].x)
  # print(arr2[0].x)

  var arr3 = arr2.copy
  print(arr3[0].x)

  # subscript_1(arr3, 0, {|foo|
  #   foo.x = 42
  # })

  print(arr3[0].x)


fn subscript_inout!(T)(arr: inout Array!T, idx: int, f) @subscript:
  # var ref input = compiler.unsafe_subscript!T(arr.data.data, idx)
  # var x = 32 + idx
  var ref input = compiler.unsafe_subscript!T(arr.data.data, idx)&
  f(input)
  compiler.unsafe_set_subscript(arr.data.data, idx, input&)

fn subscript_let!(T)(arr: Array!T, idx: int, f) @subscript:
  let input = compiler.unsafe_subscript!T(arr.data.data, idx)
  f(input)

fn subscript_sink!(T)(arr: inout Array!T, idx: int, f) @subscript:
  var input = compiler.unsafe_subscript!T(arr.data.data, idx)&
  f(input)

