fn test_set() {
  var buffer = Buffer(size: 0, data: rawptr(0))
  var arr = Array!Foo(len: 0, data: buffer&)
  arr&.init_array(initial_length: 10)

  arr[0] = Foo(x: 1, y: 2.0)
  print("Set", arr[0])
}


fn test_loop() {

  var foo = Foo(x: 1, y: 2.0)
  var i = 0
  while i < 10 {
    print(foo[i])
    i += 1
  }
}



fn test_basic_pointers() {
  var thing = malloc_or_exit(size_bytes: 20)

  compiler.unsafe_set_subscript(thing, 0, 23)
  
  print(thing)

  let x = compiler.unsafe_subscript!int(thing, 0)
  print(x)
}


