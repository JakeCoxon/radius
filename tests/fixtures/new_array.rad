fn test_move() {
  var buffer = Buffer(size: 0, data: rawptr(0))
  var arr = Array!Array!Foo(len: 0, data: buffer&)
  arr&.init_array(initial_length: 10)

  var moved = arr&
  print(moved)
  

  var buffer2 = Buffer(size: 0, data: rawptr(0))
  var arr2 = Array!Array!Foo(len: 0, data: buffer2&)

  moved = arr2&

  print(moved)
}


