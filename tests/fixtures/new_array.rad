import compiler

fn malloc_or_exit(size_bytes size: int) -> rawptr {
  var ptr = malloc(size)
  if ptr == rawptr(0) {
    exit(status: 1)
  }
  print("Malloc", size, ptr)
  ptr
}

define Foo @struct {
  x: int
  y: float

  const __subscript = subscript_foo
  const __subscript_inout = subscript_inout_foo
}


fn subscript_foo(_ arr: Foo, _ idx: int, _ f) @subscript {
  let x = 123 + idx * 10
  f(x)
}


fn subscript_inout_foo(_ arr: inout Foo, _ idx: int, _ f) @subscript {
  var x = 123 + idx * 10
  f(x)
  print("Subscript inout", x)
}


fn memset(pointer ptr: inout rawptr, value: u8, size_bytes size: int) {
  var i = 0
  while i < size {
    compiler.unsafe_set_subscript(ptr, i, value)
    i += 1
  }
}


define Buffer @struct {
  size: int
  data: rawptr

  const __destructor = deinit_buffer
  const __move_init = move_init_buffer
  const __move_assign = move_assign_buffer
  const __copy = copy_buffer
}


fn buffer_alloc(_ buf: inout Buffer, _ size: int) {
  print("Alloc size", size)
  buf.size = size
  buf.data = malloc_or_exit(size_bytes: size)
  memset(pointer: buf.data&, value: u8(0), size_bytes: size)
}


fn copy_buffer(_ dst: set Buffer, _ buf: Buffer) {
  print("Copy buffer")
  dst.size = buf.size
  dst.data = malloc_or_exit(size_bytes: buf.size)
}


fn move_init_buffer(_ dst: set Buffer, _ src: sink Buffer) {
  print("Move init buffer", dst as rawptr, src as rawptr)
  print("Source size", src.size)
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)
}


fn move_assign_buffer(_ dst: inout Buffer, _ src: sink Buffer) {
  print("Move assign buffer", dst as rawptr, src as rawptr, rawptr(dst) == rawptr(src))
  deinit_buffer(dst&)
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)
  src.size = 0
}


fn deinit_buffer(_ buf: sink Buffer) {
  print("Deinit buffer")
  if buf.data != rawptr(0) {

    print("Free buffer", buf.data as rawptr)
    // free(buf.data)
    buf.data = rawptr(0)
  }
}


define Array!(T) @struct {
  len: int
  data: Buffer

  const __subscript = get_array
  const __subscript_inout = subscript_inout
  const __subscript_sink = subscript_sink
  const __copy = copy_array
  const __move_init = move_init_array
  const __move_assign = move_assign_array
  const __destructor = deinit_array
}


fn init_array!(T)(_ arr: inout Array!T, initial_length len: int) {
  print("init array")
  arr.len = len
  print("meta T.sizeof", (meta T.sizeof))
  let size_bytes = len * (meta T.sizeof)
  print("init array buffer alloc")
  arr.data&.buffer_alloc(size_bytes)
  print("init array buffer alloc done")
}


fn reserve_array!(T)(_ arr: inout Array!T, _ len: int) {
  if len > arr.len {
    print("Reserve array", len, arr.len)
    arr.len = len
    let size_bytes = len * (meta T.sizeof)
    arr.data&.buffer_alloc(size_bytes: size_bytes)
  }
}


fn get_array!(T)(_ arr: Array!T, _ index: int, _ f) @subscript {
  // if true:
  //   print("Not allocated")
  //   exit(1)
  if arr.data.data == rawptr(0) {
    print("Not allocated")
    exit(status: 1)
  }
  if index < 0 or index >= arr.len {
    print("Bounds check failed")
    exit(status: 1)
  }
  f(compiler.unsafe_subscript!T(arr.data.data, index))
  // f(3)
}


fn copy_array!(T)(_ dst: set Array!T, _ src: Array!T) {
  print("Copy")
  print("T.sizeof", (meta T.sizeof))
  print("src.len", src.len)
  print("alloc_size", src.len * (meta T.sizeof))
  
  dst.len = src.len
  dst.data = Buffer(size: 0, data: rawptr(0))
  // // print("Copy", src.len)
  dst.data&.buffer_alloc(src.len * (meta T.sizeof))

  // print("data", dst.data.data)

  var i = 0
  while i < src.len {
    dst[i] = src[i].copy
    i += 1
  }

  // TODO: Too many moves ends up calling destructorFoo a lot
  // TODO: The copy is moving the value out of src[i] (need projection)
}


fn move_init_array!(T)(_ dst: set Array!T, _ src: sink Array!T) {
  print("Move init array")
  dst.len = src.len&
  dst.data = src.data&
  src.data = Buffer(size: 0, data: rawptr(0))
  print("Move init array done")
}


fn move_assign_array!(T)(_ dst: inout Array!T, _ src: sink Array!T) {
  print("Move assign array")
  deinit_array(dst&)
  dst.len = src.len&
  dst.data = src.data&
  src.data = Buffer(size: 0, data: rawptr(0))
  print("Move assign array done")
}


fn deinit_array!(T)(_ arr: sink Array!T) {
  print("Deinit array")
  if arr.data.data != rawptr(0) {
    var i = 0
    while i < arr.len {
      print("Deinit", i)
      var input = compiler.unsafe_subscript!T(arr.data.data, i)&
      i += 1
    }
    arr.data&.deinit_buffer()
  }
}



fn test_array1() {

  var buffer = Buffer(size: 0, data: rawptr(0))
  var arr = Array!int(len: 0, data: buffer&)
  arr&.init_array(initial_length: 5)

  arr[0] = 10
  arr[1] = 20
  arr[2] = 30
  arr[3] = 40
  arr[4] = 50
  print(arr[0])

  var arr2 = arr.copy
  print("Copied", arr2[0])
  print("Copied", arr2[1])
  print("Copied", arr2[2])
  print("Copied", arr2[4])
  // compiler.assert(arr2[0] == 10)
}


fn subscript_inout!(T)(_ arr: inout Array!T, _ idx: int, _ f) @subscript {
  // var ref input = compiler.unsafe_subscript!T(arr.data.data, idx)
  // var x = 32 + idx
  var ref input = compiler.unsafe_subscript!T(arr.data.data, idx)&
  f(input)
  // compiler.unsafe_set_subscript(arr.data.data, idx, input&)
}


fn subscript_sink!(T)(_ arr: sink Array!T, _ idx: int, _ f) @subscript {
  var input = compiler.unsafe_subscript!T(arr.data.data, idx)&
  f(input)
}


fn subscript_let!(T)(_ arr: Array!T, _ idx: int, _ f) @subscript {
  let input = compiler.unsafe_subscript!T(arr.data.data, idx)
  f(input)
}


