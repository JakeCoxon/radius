import compiler for assert

# Globals can be out of order

let foo1 = Foo(2.0, thing2)

var global1 = 123

let thing2 = foo()
var thing = 100
let thing3 = meta 1 + 2 + 3

type Foo @struct:
  x: float
  y: int

fn foo() -> int:
  thing += 1
  thing * 10

var state = 0

fn test_mutable_state():

  # Make sure to test a bug where the state object
  # is initialized inside the while loop, but after
  # exiting the loop the state is deleted and it's
  # a compile error

  var i = 0
  while i < 10:
    i += 1
    state += 1
  
  print(state)

fn test_various():
  assert(thing == 101)

  foo()
  foo()
  thing += 10
  print(thing)
  print(foo1)

  assert(thing3 == 6)
  assert(global1 == 123)
  assert(foo1.x == 2.0)
  assert(foo1.y == 1010)


fn main():
  test_various()

  test_mutable_state()

  print("Passed")