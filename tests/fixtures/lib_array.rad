import compiler
import compiler for assert
import array for Array, Buffer, array_create


define Foo @struct {
  x: int
  y: float

  const __subscript = subscript_foo
  const __subscript_inout = subscript_inout_foo
}


fn subscript_foo(arr: Foo, idx: int, f) @subscript {
  let x = 123 + idx * 10
  f(x)
}

fn subscript_inout_foo(arr: inout Foo, idx: int, f) @subscript {
  var x = 123 + idx * 10
  f(x)
  print("Subscript inout", x)
}



fn bar(x: inout int) {
  x += 1
}


fn baz(foo: inout Foo) {
  foo.x += 1
}


fn test_array1() {

  var arr = array_create!int(0)

  arr&.append(123)
  arr&.append(456)
  arr&.append(789)
  arr&.append(432)
  arr&.append(532)

  print(arr)

  var arr2 = arr.copy
  print("Copied", arr2)
  compiler.assert(arr2[0] == 123)
}


fn test_move() {
  var arr = array_create!Array!Foo(0)

  arr&.append(array_create!Foo(0))

  var moved = arr&
  print(moved)
  
  var arr2 = array_create!Array!Foo(0)

  moved = arr2&

  print(moved)
}


fn test_project() {

  var arr = array_create!Foo(0)
  arr&.append(Foo(1, 2.0))

  var ref foo = arr[0]&
  foo.x += 1
  print("rawptr", rawptr(foo))

  print(foo)
  print(arr[0])

  assert(arr[0].x == 2)
}

  
fn test_sink_elem() {
  var arr = array_create!Foo(0)
  arr&.append(Foo(1, 2.0))

  var moved = arr[0]&
  print("Moved", moved)

  # TODO: This should be a compile time error some how
  # but right now it will allow it and cause undefined behaviour
  # print(arr)
}


fn test_basic_project() {
  var f = Foo(1, 2.0)

  print(f[0])
  print(f[10])
  foo(f[0]&)
}


fn foo(foo: inout int) {
  foo += 1
}


fn test_set() {
  var arr = array_create!Foo(0)
  arr&.append(Foo(1, 2.0))
  arr[0] = Foo(3, 13.0)

  print("Set", arr[0])
  assert(arr[0].x == 3)
  assert(arr[0].y == 13.0)
}


fn test_loop() {

  var foo = Foo(1, 2.0)
  var i = 0
  while i < 10 {
    print(foo[i])
    i += 1
  }
}


fn main() {

  test_array1()
  # test_array2()
  # test_array3()
  test_move()
  test_project()
  test_sink_elem()
  test_loop()
  test_basic_project()
  test_set()
}
