import vec for vec2
import compiler for overloaded, assert

// Mandatory positional args
fn calculate_xywh(_ x: float, _ y: float, _ w: float, _ h: float) -> float {
  x + y + 100 * w + 200 * h
}

// Mandatory named args
fn calculate_named(x: float, y: float, w: float, h: float) -> float {
  calculate_xywh(x, y, w, h)
}

// Mandatory named args
fn calculate_pos_size(pos: vec2, size: vec2) -> float {
  calculate_xywh(pos.x, pos.y, size.x, size.y)
}

const calculate = overloaded([
  calculate_xywh, calculate_pos_size, calculate_named
])

fn main() {
  assert(calculate_xywh(1, 2, 3, 4) == 1103)
  assert(calculate_pos_size(pos: vec2(1, 2), size: vec2(3, 4)) == 1103)

  assert(calculate(pos: vec2(1, 2), size: vec2(3, 4)) == 1103)

  assert(calculate(1, 2, 3, 4) == 1103)
  assert(calculate(pos: vec2(1, 2), size: vec2(3, 4)) == 1103)

  // Named args
  assert(calculate(size: vec2(3, 4), pos: vec2(1, 2)) == 1103)
  assert(calculate(x: 1, y: 2, w: 3, h: 4) == 1103)
  assert(calculate(1, 2, 3, 4) == 1103)
}