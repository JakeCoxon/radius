
fn thing4(x: int) {
  return x + 2
}

fn fam!(T)(a: int) {
  print(a)
  print(T)
}

fn famz!(T)(a: T) {
  print(a)
}

define Thing {
  x: int
  y: float
}

define MyList!(T) {
  elem: T
}

fn foothing(a: Thing) {
  print(a.x)
  // print(a)
}

fn foo_list!(E)(a: MyList!E) {
  print(a.elem)
}



fn foo(x: int, y: float) -> Thing {
  Thing(x: x, y: y)
}


fn create_thing() -> MyList!Thing {
  var foo = foo(x: 1, y: float(2))
  MyList!Thing(elem: foo&)
}


fn main() {

  const foo = {|x| x + 1}

  foo(1)

  var my_list: MyList!int
  my_list.elem = 32
  foo_list!int(a: my_list)

  var thing: Thing
  print(thing.x + 32)
  foothing(a: thing)

  fam!2(a: 1)
  fam!(1 + 1)(a: 2)

  famz!int(a: 200)
  famz!bool(a: true)

  let thing2 = Thing(x: 1, y: float(2))

  let ret_val = create_thing()
  print(ret_val)
  print(ret_val.elem)
}