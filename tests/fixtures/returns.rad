import compiler for assert

fn foo(_ z: int) {
  if 2 > 0 {
    return
  }
  print("OK")
}

fn bam() -> int {
  if 2 == 2 {
    return 2
  }
  return 8
}

fn bar() -> int {
  if 2 == 2 {
    return 2
  }
  23
}

fn main() {

  foo(2)

  let a2 = bam()
  assert(a2 == 2)
  
  let a3 = bar()
  assert(a3 == 2)
}