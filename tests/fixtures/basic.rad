import compiler

fn malloc_or_exit(size: int) -> rawptr:
  var ptr = malloc(size)
  if ptr == rawptr(0):
    exit(1)
  print("Malloc", size, ptr)
  ptr

type Foo @struct:
  x: int
  y: float

  const __subscript = subscript_foo
  const __subscript_inout = subscript_inout_foo


fn subscript_foo(arr: Foo, idx: int, f) @subscript:
  let x = 123 + idx * 10
  f(x)

fn subscript_inout_foo(arr: inout Foo, idx: int, f) @subscript:
  var x = 123 + idx * 10
  f(x)
  print("Subscript inout", x)


fn memset(ptr: inout rawptr, value: u8, size: int):
  var i = 0
  while i < size:
    compiler.unsafe_set_subscript(ptr, i, value)
    i += 1


type Buffer @struct:
  size: int
  data: rawptr

  const __destructor = deinit_buffer
  const __move_init = move_init_buffer
  const __move_assign = move_assign_buffer
  const __copy = copy_buffer


fn buffer_alloc(buf: inout Buffer, size: int):
  print("Alloc size", size)
  buf.size = size
  buf.data = malloc_or_exit(size)
  memset(buf.data&, u8(0), size)


fn copy_buffer(dst: set Buffer, buf: Buffer):
  print("Copy buffer")
  dst.size = buf.size
  dst.data = malloc_or_exit(buf.size)


fn move_init_buffer(dst: set Buffer, src: sink Buffer):
  print("Move init buffer", dst as rawptr, src as rawptr)
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)


fn move_assign_buffer(dst: inout Buffer, src: sink Buffer):
  print("Move assign buffer", dst as rawptr, src as rawptr, rawptr(dst) == rawptr(src))
  deinit_buffer(dst&)
  dst.size = src.size&
  dst.data = src.data&
  src.data = rawptr(0)
  src.size = 0


fn deinit_buffer(buf: sink Buffer):
  print("Deinit buffer")
  if buf.data != rawptr(0):

    print("Free buffer", buf.data as rawptr)
    # free(buf.data)
    buf.data = rawptr(0)


type Array!(T) @struct:
  len: int
  data: Buffer

  const __iterate = array_iterate
  const __subscript = get_array
  const __subscript_inout = subscript_inout
  const __subscript_sink = subscript_sink
  const __copy = copy_array
  const __move_init = move_init_array
  const __move_assign = move_assign_array
  const __destructor = deinit_array
  const __print = print_array2


fn print_array2!(T)(arr: Array!T):
  var i = 0
  print("[", endl=false)
  while i < arr.len:
    if i > 0:
      print(", ", endl=false)
    print(arr[i], endl=false)
    i += 1
  print("]", endl=false)


fn init_array!(T)(arr: inout Array!T, len: int):
  print("init array")
  arr.len = len
  print("meta T.sizeof", (meta T.sizeof))
  let size_bytes = len * (meta T.sizeof)
  print("init array buffer alloc")
  arr.data&.buffer_alloc(size_bytes)
  print("init array buffer alloc done")


fn reserve_array!(T)(arr: inout Array!T, len: int):
  if len > arr.len:
    print("Reserve array", len, arr.len)
    arr.len = len
    let size_bytes = len * (meta T.sizeof)
    arr.data&.buffer_alloc(size_bytes)


fn get_array!(T)(arr: Array!T, index: int, f) @subscript:
  # if true:
  #   print("Not allocated")
  #   exit(1)
  if arr.data.data == rawptr(0):
    print("Not allocated")
    exit(0)
  if index < 0 or index >= arr.len:
    print("Bounds check failed")
    exit(0)
  f(compiler.unsafe_subscript!T(arr.data.data, index))
  # f(3)


fn copy_array!(T)(dst: set Array!T, src: Array!T):
  print("Copy")
  print("T.sizeof", (meta T.sizeof))
  print("src.len", src.len)
  print("alloc_size", src.len * (meta T.sizeof))
  
  dst.len = src.len
  dst.data = Buffer(0, rawptr(0))
  # # print("Copy", src.len)
  dst.data&.buffer_alloc(src.len * (meta T.sizeof))

  # print("data", dst.data.data)

  var i = 0
  while i < src.len:
    dst[i] = src[i].copy
    i += 1

  # TODO: Too many moves ends up calling destructorFoo a lot
  # TODO: The copy is moving the value out of src[i] (need projection)

fn print_array!(T)(arr: Array!T):
  var i = 0
  while i < arr.len:
    print(arr[i])
    i += 1

fn array_iterate!(f, T)(array: Array!T) -> void @inline:
  var i = 0
  while i < array.len:
    f(array[i])
    i += 1

fn array_iterate_inout!(T)(array: inout Array!T, f) -> void @inline:
  var i = 0
  while i < array.len:
    f(array[i]&)
    i += 1

fn move_init_array!(T)(dst: set Array!T, src: sink Array!T):
  print("Move init array")
  dst.len = src.len&
  dst.data = src.data&
  src.data = Buffer(0, rawptr(0))
  print("Move init array done")

fn move_assign_array!(T)(dst: inout Array!T, src: sink Array!T):
  print("Move assign array")
  deinit_array(dst&)
  dst.len = src.len&
  dst.data = src.data&
  src.data = Buffer(0, rawptr(0))
  print("Move assign array done")

fn deinit_array!(T)(arr: sink Array!T):
  print("Deinit array")
  if arr.data.data != rawptr(0):
    var i = 0
    while i < arr.len:
      print("Deinit", i)
      var input = compiler.unsafe_subscript!T(arr.data.data, i)&
      i += 1
    arr.data&.deinit_buffer()

fn bar(x: inout int):
  x += 1


fn baz(foo: inout Foo):
  foo.x += 1


