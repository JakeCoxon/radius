fn test_move():
  var buffer = Buffer(0, rawptr(0))
  var arr = Array!Array!Foo(0, buffer&)
  arr&.init_array(10)

  var moved = arr&
  print(moved)
  

  var buffer2 = Buffer(0, rawptr(0))
  var arr2 = Array!Array!Foo(0, buffer2&)

  moved = arr2&

  print(moved)


