fn test_set():
  var buffer = Buffer(0, rawptr(0))
  var arr = Array!Foo(0, buffer&)

  arr&.init_array(10)

  arr[0] = Foo(1, 2.0)
  print("Set", arr[0])

  print(arr)

fn test_loop():

  var foo = Foo(1, 2.0)
  var i = 0
  while i < 10:
    print("x", foo[i])
    i += 1


fn test_break():
  var i = 0
  while i < 10:
    print("i", i)
    i += 1
    if i == 5:
      break
  print("Done")


fn test_borrow():
  var foo = Foo(1, 2.0)
  var ref foo2 = foo&
  if true:
    let x = foo2.x
    print(x)


type Person:
  name : string
  age : int

fn test_string():
  var str = "Hello"
  print(str)

  var person = Person("Jake", 300)
  print(person)
  

fn test_sink():
  let asd = Foo(1, 2.0)
  let two = asd
  let thing = two.x
  let num = thing + 2
  print(num)


fn test_print():
  var arr = Array!Array!int(0, Buffer(0, rawptr(0))&)
  arr&.init_array(10)
  arr[0]&.init_array(10)
  arr[0][0] = 123
  
  print(arr)

