
define Bar {
  f: int
  g: float
}

define Foo {
  x: int
  y: float
  bar: Bar
}

define Custom {
  x: int
  y: int

  const __print = print_custom
}

fn print_custom(_ c: Custom) {
  print("Custom<", c.x, c.y, ">")
}

fn test_foo() {
  let foo = Foo(x: 1, y: 2.0, bar: Bar(f: 3, g: 4.0))
  print(true)
  print(123)
  print(123.0)

  let x = (Bar(f: 3, g: 4.0), 2)
  print(x)
  print("Foo is", foo)

  print(Custom(x: 1, y: 2))
}


fn main() {
  test_foo()
}