define Person {
  name : string
  age : int
}

define MyVec {
  x : int
  y : int
}

fn foo(_ tup: (int, float, Person, MyVec)) {
  print(tup._1 + int(tup._2) + tup._3.age + tup._4.x + tup._4.y)
}

fn modify_tuple(_ tup: inout (int, float, Person, MyVec)) {
  tup._3.age = 31
  tup._4.x = 12
  tup._4.y = 10
}

fn main() {
  var vec = MyVec(x: 4, y: 3)
  var person = Person(name: "Jake", age: 300)

  var tup = (1, float(2), person&, vec&)

  modify_tuple(tup&)

  foo(tup)

  var new_vec = MyVec(x: 30, y: 40)
  var new_person = Person(name: "Another Person", age: 100)
  var new_person2 = new_person.copy
  // overwrite tup
  tup = (23, float(67), new_person&, new_vec&)


  foo(tup)
  print(tup)

  let list = [MyVec(x: 30, y: 40), MyVec(x: 1, y: 2), MyVec(x: 3, y: 6)]

  let x = list[0].x + list[1].y
  print(x)

  let list2 = [
    Person(name: "Person1", age: 101), 
    Person(name: "Person2", age: 102), 
    Person(name: "Person3", age: 103)]

  print(list2[0].age)

  let list3 = [
    ("A", 23, float(67), new_person2.copy, MyVec(x: 124, y: 53)), 
    ("B", 13, float(12), new_person2.copy, MyVec(x: 123, y: 40)), 
    ("C", 51, float(67), new_person2.copy, MyVec(x: 312, y: 23))]

  print(list3[:]) ...

  print(list3[:]._1) ...
  print(list3[:]._2) ...
  print(list3[:]._3) ...
  print(list3[:]._4) ...
}