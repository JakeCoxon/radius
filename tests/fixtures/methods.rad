
define Thing {
  x : int
  y : int
}

fn foo(_ thing: Thing, z: int) {
  print(thing.x + z)
}

fn bam(_ thing: Thing) {
  print(thing.x)
}

fn main() {

  var thing = Thing(x: 0, y: 0)

  thing.x = 1
  thing.y = 10
  print(thing.x + thing.y)

  thing.foo(z: 200)
  thing.bam

  const fam = {|x| x + 100}

  let x = 2.fam
}