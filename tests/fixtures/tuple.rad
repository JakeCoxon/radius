define Thing {
  x : int
  y : int
}


fn foo(tup: Tuple!(int, float, Thing)) {
  print(tup._1 + int(tup._2) + tup._3.x + tup._3.y)
}

fn foo2(tup: (int, float, Thing)) {
  print(tup._1 + int(tup._2) + tup._3.x + tup._3.y)
}


fn main() {
  var thing = Thing(4, 3)

  var tup = (1, float(2), thing&)

  print(tup._1 + int(tup._2) + tup._3.x + tup._3.y)

  tup = (23, float(67), tup._3&)

  foo(tup)
  foo2(tup)
}