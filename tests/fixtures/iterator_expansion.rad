import compiler for concat, assert, operator_mod
import range for Range, ints

fn error() -> never {
  exit(1)
}

define Person @struct {
  age: int
}

const foo = |yield|
  for i in Range(0, 10) {
    yield(i)
  }

const bar = |yield|
  for i in Range(1, 9) {
    yield(i * i)
  }

const bamp = |yield|
  for i in Range(1, 9) {
    yield(i * i * i)
  }

const baz = |yield|
  var f = 1
  while true {
    yield(f)
    f *= 2
  }

const squares = |yield|
  var i = 0
  while true {
    yield(i * i)
    i += 1
  }

const factorial = |yield|
  var i = 1
  var f = 1
  while true {
    yield(f)
    f *= i
    i += 1
  }

fn range2d(x: int, y: int) { {|yield|
  for j in Range(0, y) {
    for i in Range(0, x) {
      yield((i, j))
    }
  }
} }

const fixed_iterator = |yield|
  yield(123)
  if 1 == 1 {
    yield(32)
  }
  yield(123)

fn custom_iterator(x: Person, foo: int) { {|yield|
  for i in Range(0, 10) {
    yield((x.age + i, foo))
  }
} }

fn custom_iterator2(x: Person, foo: int) { {|yield|
  for i in Range(0, 10) {
    yield(x.age + i + foo)
  }
} }

fn sum(arr) @inline {
  (fold(0) + arr[:] ...)
}

fn float_sum(arr) @inline {
  (fold(0.0) + arr[:] ...)
}

fn first_or_zero(arr) @inline {
  var res = 0
  for x in arr {
    res = x
    break
  }
  res
}

fn last_or_zero(arr) @inline {
  var res = 0
  for x in arr {
    res = x
  }
  res
}

fn all(arr) @inline {
  // Issues with returning directly from the loop
  var res = true
  for x in arr {
    if !x {
      res = false
      break
    }
  }
  res
}

fn any(arr) @inline {
  // Issues with returning directly from the loop
  var res = false
  for x in arr {
    if x {
      res = true
      break
    }
  }
  res
}

fn test_fold() {

  let numbers = [40, 20, 10, 32, 12, 3124]

  let count = (fold(0) + numbers[:] * bamp[:] ...)
  print(count)
  assert(count == 678802)

  let count2 = (fold(0) + fixed_iterator[:] ...)
  assert(count2 == 278)

  const r = range2d(4, 3)
  let count3 = (fold(0) + r[:]._1 ...)
  assert(count3 == 18)
}

fn test_fold_setter() {
  let numbers = [40, 20, 10, 32, 12, 3124]
  var foos = [0, 0, 0, 0]
  foos[:] = numbers[:] * bamp[:] + 2 ...

  let count2 = (fold(0) + foos[:] ...)
  print(count2)
  assert(count2 == 2526)

  let count3 = (fold(0) + foo[:] ...)
  print(count3)
  assert(count3 == 45)
}

fn test_setters() {
  var numbers = [40, 20, 10, 32, 12, 3124]

  numbers[:] = 1 ...
  assert(numbers[:].iter.sum == 6)
  print(numbers[:]) ...

  numbers[:] = [1, 2, 3][:] ...
  assert(numbers[:].iter.sum == 9)
  print(numbers[:]) ...

  numbers[:] = fold(0) + 1 ...
  assert(numbers[:].iter.sum == 21)
  print(numbers[:]) ...
}

fn test_shorthand() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  
  let x1 = (numbers[:] > 9).iter.all
  print(x1)
  assert(x1 == true)

  let x2 = (numbers[:] < 1000).iter.all
  print(x2)
  assert(x2 == false)

  let y1 = (numbers[:] == 20).iter.any
  assert(y1 == true)
  print(y1)

  let y2 = (numbers[:] == 1000).iter.any
  assert(y2 == false)
  print(y2)

  let z1 = numbers[1:].iter.sum
  assert(z1 == 3198)
  print(z1)

  let w1 = bar[:].iter.sum
  print(w1)
  assert(w1 == 204)

  assert((squares[:] == 81).iter.any == true)
  assert((factorial[:] < 1000).iter.all == false)
}


fn test_concat() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  
  const concat1 = @concat(foo[:], bar[:])
  let x3 = concat1[:].iter.sum
  print(x3)
  assert(x3 == 249)


  const concat2 = @concat(foo[:], bar[:], bamp[:], numbers[:])
  let x4 = concat2[:].iter.sum
  print(x4)
  assert(x4 == 4783)
}

fn test_concat2() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  
  const concat1 = @concat(foo[:], bar[:], numbers[:], 2, 3, 4)
  let x3 = concat1[:].iter.sum
  print(x3)
  assert(x3 == 3496)
}

fn test_concat3() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  
  const concat1 = @concat(foo[:], bar[:], numbers[:], 2, 3, 4)
  for x in concat1 {
    print(x)
  }
}


fn test_concat4() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  
  const concat1 = @concat(foo[:], bar[:], 2, 3, 4)
  const concat2 = @concat(concat1[:], numbers[:], 5, 6, 7)

  var res = 0
  res += concat2[:] ...
  print(res)
  assert(res == 3514)
}


fn test_concat5() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  
  const concat1 = @concat(foo[:] * numbers[:], 2, 3, 4)
  let x3 = concat1[:].iter.sum
  print(x3)
  assert(x3 == 15813)
}


fn test_concat6() {

  var numbers = [40, 20, 10, 32, 12, 3124]
  
  const concat1 = @concat(foo[:] * numbers[:], 2, 3, 4)
  numbers[:] = concat1[:] ...
  print(numbers[:]) ...
}

fn test_iterator_syntax() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  let x = [foo[:] * numbers[:] ..., 2, 3, 4].iter.sum
  assert(x == 15813)

  const y = [ foo[:] ..., 2, 3, 4 ].iter
  assert(y.sum == 54)

  let z = foo.sum
  assert(z == 45)

  const w = (foo[:] + 1).iter
  assert(w.sum == 55)

  const bar = {|x| x * 2}

  let g = foo[:].bar.iter.sum
  assert(g == 90)
}

fn test_postfix() {

  const bar = {|x| x * 2}

  var i = 0
  const p = {|x|
    i += x
  }
  
  foo[:].bar.p ...
  assert(i == 90)
}

fn test_people() {

  let people = [Person(10), Person(20), Person(30), Person(40), Person(50)]
  
  let x4 = people[:].age.iter.sum
  print(x4)
  assert(x4 == 150)
}



fn test_first_last() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  
  let x = numbers[:].iter.first_or_zero
  print(x)
  assert(x == 40)

  // y = @last(numbers[:])
  // print(y)
  // assert(y == 3124)

  let people = [Person(10), Person(20), Person(30), Person(40), Person(50)]
  let age = people[1:].age.iter.first_or_zero
  assert(age == 20)

  // p2 = @last(people[:])
  // assert(p2.age == 50)
}

fn test_range() {
  let rng = Range(10, 20)
  print(rng[1:10:2]) ...

  print(ints[1:10:2]) ...

  let sum = ints[1:10:2].iter.sum
  assert(sum == 25)
}

