  let cells = [[1,2,3], [4,5,6], [7,8,9]]

  // foo = @mapcat(cells[:])

  // x = cells[:][:].iter.sum
}


fn test_custom_iterator() {
  let person = Person(10)
  const it = custom_iterator(person, 23)
  for x, y in it {
    print(x, y)
  }

  const it2 = custom_iterator2(person, 23)
  let f = it2[:].iter.sum
  assert(f == 375)

  let f2 = (meta custom_iterator2(person, 23))[:].iter.sum
  assert(f2 == 375)
}

fn test_iterator_to_array() {
  let arr = [
    3,
    factorial[:5] ...,
    factorial[10:12] ...,
    1, 2
  ]
  assert(arr.sum == 43545640)
  print(arr[:]) ...

  let arr2 = [factorial[:5] + factorial[1:6] ...]
  assert(arr2.sum == 187)

  let arr3 = [factorial[:5] if factorial[:5] > 5 ...]
  assert(arr3.sum == 30)

  let arr4 = [1, 2, 3, 5 if false]
  assert(arr4.sum == 6)
}

fn test_for_expr_array() {

  const r = range2d(4, 3)
  let arr = [x + x * y for x, y in r ...]
  assert(arr.sum == 36)
}

fn test_slice() {
  const c = @concat(factorial[2:8:2])
  assert(c.sum == 746)
}

fn test_array() {
  let x = 0.2
  let arr = [x, 1, 1]
  assert(arr.float_sum == 2.2)
}

fn test_float_sum() {
  let asd = [1, 2, 3.2]
  let s = (asd[:] + float(foo[:])).iter.float_sum
  assert(s == 9.2)
}


fn main() {
  test_fold()
  // test_fold_setter() // Capability check issue
  test_setters()
  test_shorthand()
  test_concat()
  test_concat2()
  test_concat3()
  test_concat4()
  test_concat5()
  test_concat6()
  test_iterator_syntax()
  test_postfix()
  test_people()
  test_first_last()
  test_range()
  test_stuff()
  test_for_loop()
  test_if()
  // test_sideeffect()
  test_template!int()
  test_template!float()
  test_while()
  test_flatmap()
  test_custom_iterator()
  test_iterator_to_array()
  test_for_expr_array()
  test_array()
  test_slice()
  test_float_sum()
}