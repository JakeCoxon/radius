fn test_for_loop() {

  for a in ints[1:100:10] {
    print(a)
  }

  print("--")

  for a, b, c in (ints[:4], squares[:], factorial[:]) {
    print(a, b, c)
  }

  print("--")

  for a, b in (squares[:], factorial[:]) {
    print(a, b)
    if a >= 100 {
      break
    }
  }
}

fn test_if() {

  let numbers = [43, 21, 10, 34, 12, 3124]
  let x = (numbers[:] if numbers[:] > 20).iter.sum
  print(x)
  assert(x == 3222)
  
  print(numbers[:]) if operator_mod(numbers[:], 2) == 0 ...

  print("--")

  for x in (numbers[:] if numbers[:] < 20) {
    print(x)
  }

  print("--")

  const nums = (numbers[:] if numbers[:] < 20).iter
  assert(nums.first_or_zero == 10)
  assert(nums.last_or_zero == 12)

  const cc1 = [
    numbers[:] if numbers[:] < 20 ..., 
    numbers[:] if numbers[:] > 20 ...
  ].iter
  print(cc1[:]) ...
}


fn test_while() {
  
  let numbers = [40, 20, 10, 32, 12, 3124]
  let x = (numbers[:] while numbers[:] < 100).iter.sum
  print(x)
  assert(x == 114)

  print(factorial[:]) while numbers[:] < 100 ...

  for x in (numbers[:] while numbers[:] < 100) {
    print(x)
  }
}

fn test_sideeffect() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  let calls = 0

  const side = {||
    print("sideeffect")
    calls += 1
    500
  }

  let x = (numbers[:] > side()).iter.any
  assert(calls == 1)
}

fn test_template!(T)() {

  let numbers = [40, 20, 10, 32, 12, 3124]
  let x = numbers[:].iter.sum
  print(x)
}


