import compiler for Option, Some, None, assert, is_enum_variant, unsafe_enum_cast

fn filter_some(iterable) @inline: {|yield|
  for x in iterable:
    if let .Some(y) = x:
      yield(y)
      0 # Compiler error if this is not here
}


fn sum(iterable) @inline:
  (fold(0) + iterable[:] ...)

# fn max2!(T)(iterable) @inline: {
#   let m = fold(None!T())
#   let it = iterable[:]
#   ifx it > m.orelse(0): Some(it) else: m
# } ...

# const max_by_opt = {|max, it|
#   (ifx it > max.orelse(0): Some(it) else: max)
# }
# fn max2!(T)(iterable) @inline: 
#   max_by_opt(fold(None!T()), iterable[:]) ...

fn max2!(T)(iterable) @inline:
  var m = None!T()
  for it in iterable:
    if it > m.orelse(0):
      m = Some(it)
  m


fn test_filter():
  let numbers = [1, 2, 3, 4, 5]

  const foo = {|x|
    (ifx x > 2:
      Some(x)
    else:
      None!int())
  }
  
  const x = filter_some(foo(numbers[:]).iter)
  assert(x.sum == 12)
  print(x[:]) ...


fn test_max():
  let numbers = [1, 2, 3, 4, 5]
  let m = numbers.max2!int

  let v = { m? * 10 }.orelse 0
  assert(v == 50)
  print(v)


fn test_early_exit():
  let numbers = [1, 2, 3, 4, 5]

  const foo = {|x| ifx x > 2: Some(x) else: None!int() }
  let y = Some(23)

  let x = {
    foo(numbers[:])?.iter.sum + y?
  }.orelse 32
  assert(x == 32)


fn test_early_exit_sideffect():
  let numbers = [1, 2, 3, 4, 5, 2, 1]
  let y = Some(23)

  var sideeffects = 0

  const foo = {|x| 
    sideeffects += 1
    ifx x < 3: Some(x) else: None!int()
  }

  # This breaks out of the try block within the ... expansion
  # so that all numbers are visited
  var r = 0
  { r += numbers[:].foo? } ...
  assert(r == 6)
  assert(sideeffects == 7)

  sideeffects = 0

  # This one breaks out of the entire try block so only the
  # first 3 numbers are visited
  var s = 0
  { s += numbers[:].foo? ... }
  assert(s == 3)
  assert(sideeffects == 3)


fn main():
  test_filter()
  test_max()
  test_early_exit()
  test_early_exit_sideffect()