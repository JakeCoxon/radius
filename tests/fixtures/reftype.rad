import compiler for assert

define Thing {
  x : int
  y : float
}

fn foothing(a: inout Thing) {
  print(a.x)
  // print(a)
  a.x = 64
  a.y = float(100)
}

fn main() {

  var thing: Thing
  thing = Thing(32, float(100))

  print(thing.x)
  print(thing.y)
  foothing(thing&)

  assert(thing.x == 64)
  assert(thing.y == 100.0)
}